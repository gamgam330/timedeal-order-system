{
  "uid": "timedeal-app",
  "title": "Timedeal App",
  "description": "부하 테스트 중 서버 내부에서 무슨 일이 일어나는지 본다: 요청 → 스레드 → 커넥션 → JVM",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["timedeal"],
  "panels": [
    {
      "type": "row", "title": "HTTP: 클라이언트가 보는 것", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries", "title": "RPS (uri, status별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{application=\"timedeal\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries", "title": "레이턴시 p95 / p99 (uri별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"timedeal\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p95 {{method}} {{uri}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"timedeal\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "p99 {{method}} {{uri}}"
        }
      ]
    },
    {
      "type": "row", "title": "DB 커넥션 풀 (HikariCP): 병목이 생기는 첫 번째 지점", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries", "title": "커넥션: active / idle / pending / max",
      "description": "pending이 0보다 크면 커넥션을 기다리는 스레드가 있다는 뜻이다",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active{application=\"timedeal\"})", "legendFormat": "active" },
        { "refId": "B", "expr": "sum(hikaricp_connections_idle{application=\"timedeal\"})", "legendFormat": "idle" },
        { "refId": "C", "expr": "sum(hikaricp_connections_pending{application=\"timedeal\"})", "legendFormat": "pending" },
        { "refId": "D", "expr": "sum(hikaricp_connections_max{application=\"timedeal\"})", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries", "title": "커넥션 획득 시간과 타임아웃",
      "description": "획득 시간이 길어지면 요청이 DB가 아니라 '커넥션 줄 서기'에서 시간을 쓰고 있는 것이다",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "timeout/s" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "custom.axisPlacement", "value": "right" }] }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(hikaricp_connections_acquire_seconds_sum{application=\"timedeal\"}[$__rate_interval])) / sum(rate(hikaricp_connections_acquire_seconds_count{application=\"timedeal\"}[$__rate_interval]))", "legendFormat": "평균 획득 시간" },
        { "refId": "B", "expr": "max(hikaricp_connections_acquire_seconds_max{application=\"timedeal\"})", "legendFormat": "최대 획득 시간" },
        { "refId": "C", "expr": "sum(rate(hikaricp_connections_timeout_total{application=\"timedeal\"}[$__rate_interval]))", "legendFormat": "timeout/s" }
      ]
    },
    {
      "type": "timeseries", "title": "커넥션 점유 시간 (빌려서 반납하기까지)",
      "description": "트랜잭션 안에서 외부 호출을 하면 이 값이 늘어난다",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(hikaricp_connections_usage_seconds_sum{application=\"timedeal\"}[$__rate_interval])) / sum(rate(hikaricp_connections_usage_seconds_count{application=\"timedeal\"}[$__rate_interval]))", "legendFormat": "평균 점유 시간" },
        { "refId": "B", "expr": "max(hikaricp_connections_usage_seconds_max{application=\"timedeal\"})", "legendFormat": "최대 점유 시간" }
      ]
    },
    {
      "type": "timeseries", "title": "Tomcat 스레드: busy / max",
      "description": "busy가 max에 붙으면 요청이 accept 큐에서 대기한다",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(tomcat_threads_busy_threads{application=\"timedeal\"})", "legendFormat": "busy" },
        { "refId": "B", "expr": "sum(tomcat_threads_config_max_threads{application=\"timedeal\"})", "legendFormat": "max" }
      ]
    },
    {
      "type": "row", "title": "JVM", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "timeseries", "title": "CPU 사용률",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage{application=\"timedeal\"}", "legendFormat": "process" },
        { "refId": "B", "expr": "system_cpu_usage{application=\"timedeal\"}", "legendFormat": "system" }
      ]
    },
    {
      "type": "timeseries", "title": "Heap 사용량",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{application=\"timedeal\", area=\"heap\"})", "legendFormat": "used" },
        { "refId": "B", "expr": "sum(jvm_memory_max_bytes{application=\"timedeal\", area=\"heap\"})", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries", "title": "GC 정지 시간 (초당)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (gc) (rate(jvm_gc_pause_seconds_sum{application=\"timedeal\"}[$__rate_interval]))", "legendFormat": "{{gc}}" }
      ]
    }
  ]
}
